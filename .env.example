# ==============================================================================
# Travety Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection
# ------------------------------------------------------------------------------
# Get your Connection URI from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Example (Session pooler / Transaction pooler / Direct):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# (Alternative) Individual SQL connection fields
SQL_HOST=
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=postgres

# ------------------------------------------------------------------------------
# Google APIs
# ------------------------------------------------------------------------------
# Google Gemini API Key (for AI commute coordination & search grounding)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Maps API Key (client-side interactive campus & metro map)
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Deployment Configuration (Vercel + Render)
# ------------------------------------------------------------------------------
# Render backend service URL used by the Vercel frontend.
# Leave blank for local development. Set to your Render URL on Vercel (e.g. https://travety-backend.onrender.com)
VITE_API_URL=

