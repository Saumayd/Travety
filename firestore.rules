rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidLobby(data) {
      return data.keys().hasAll([
        'code', 'title', 'hostName', 'hostId', 'mode', 'centralHub',
        'departureTime', 'activePings', 'lastPingBy', 'sosActive',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'title', 'hostName', 'hostId', 'mode', 'centralHub',
        'departureTime', 'activePings', 'lastPingBy', 'sosActive',
        'createdAt', 'updatedAt'
      ]) &&
      data.code is string && data.code.size() >= 4 && data.code.size() <= 16 && data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
      data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 50 &&
      data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
      data.mode is string && data.mode.size() <= 10 && (data.mode == 'safe' || data.mode == 'fun') &&
      data.centralHub is string && data.centralHub.size() >= 1 && data.centralHub.size() <= 100 &&
      data.departureTime is string && data.departureTime.size() >= 1 && data.departureTime.size() <= 20 &&
      data.activePings is int && data.activePings >= 0 && data.activePings <= 10000 &&
      data.lastPingBy is string && data.lastPingBy.size() <= 60 &&
      data.sosActive is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMember(data) {
      return data.keys().hasAll([
        'lobbyCode', 'userId', 'name', 'initials', 'gender',
        'location', 'curfew', 'accompanyingDetails', 'budget',
        'phone', 'leaveByTime', 'transitMins', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'lobbyCode', 'userId', 'name', 'initials', 'gender',
        'location', 'curfew', 'accompanyingDetails', 'budget',
        'phone', 'leaveByTime', 'transitMins', 'createdAt', 'updatedAt'
      ]) &&
      data.lobbyCode is string && data.lobbyCode.size() >= 4 && data.lobbyCode.size() <= 16 && data.lobbyCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
      data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4 &&
      data.gender is string && data.gender.size() <= 16 && (data.gender == 'female' || data.gender == 'male') &&
      data.location is string && data.location.size() >= 1 && data.location.size() <= 100 &&
      data.curfew is string && data.curfew.size() >= 1 && data.curfew.size() <= 20 &&
      data.accompanyingDetails is string && data.accompanyingDetails.size() >= 1 && data.accompanyingDetails.size() <= 100 &&
      data.budget is int && data.budget >= 0 && data.budget <= 100000 &&
      data.phone is string && data.phone.size() <= 20 &&
      data.leaveByTime is string && data.leaveByTime.size() >= 1 && data.leaveByTime.size() <= 20 &&
      data.transitMins is int && data.transitMins >= 5 && data.transitMins <= 300 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPollOption(data) {
      return data.keys().hasAll([
        'lobbyCode', 'title', 'subtitle', 'votes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'lobbyCode', 'title', 'subtitle', 'votes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.lobbyCode is string && data.lobbyCode.size() >= 4 && data.lobbyCode.size() <= 16 && data.lobbyCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
      data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 120 &&
      data.votes is int && data.votes >= 0 && data.votes <= 10000 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAreaReview(data) {
      return data.keys().hasAll([
        'userId', 'authorName', 'areaName', 'safetyRating',
        'lightingStatus', 'issueFlag', 'comment', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'authorName', 'areaName', 'safetyRating',
        'lightingStatus', 'issueFlag', 'comment', 'createdAt'
      ]) &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
      data.areaName is string && data.areaName.size() >= 1 && data.areaName.size() <= 80 &&
      data.safetyRating is int && data.safetyRating >= 1 && data.safetyRating <= 5 &&
      data.lightingStatus is string && data.lightingStatus.size() >= 1 && data.lightingStatus.size() <= 40 &&
      data.issueFlag is string && data.issueFlag.size() >= 1 && data.issueFlag.size() <= 60 &&
      data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 300 &&
      data.createdAt is timestamp;
    }

    match /lobbies/{lobbyCode} {
      allow get: if isSignedIn() && isValidId(lobbyCode);
      allow list: if isSignedIn() && existing().hostId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(lobbyCode) &&
        isValidLobby(incoming()) &&
        incoming().code == lobbyCode &&
        incoming().hostId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(lobbyCode) &&
        isValidLobby(incoming()) &&
        incoming().code == existing().code &&
        incoming().hostId == existing().hostId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'mode', 'centralHub', 'departureTime', 'activePings', 'lastPingBy', 'sosActive', 'updatedAt'
          ]) ||
          (existing().hostId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'mode', 'centralHub', 'departureTime', 'activePings', 'lastPingBy', 'sosActive', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isValidId(lobbyCode) && existing().hostId == request.auth.uid;

      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(lobbyCode) && isValidId(memberId) &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));
        allow list: if isSignedIn() && existing().lobbyCode == lobbyCode;

        allow create: if isSignedIn() &&
          isValidId(lobbyCode) &&
          isValidId(memberId) &&
          isValidMember(incoming()) &&
          incoming().lobbyCode == lobbyCode &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));

        allow update: if isSignedIn() &&
          isValidId(lobbyCode) &&
          isValidId(memberId) &&
          isValidMember(incoming()) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().lobbyCode == existing().lobbyCode &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'initials', 'gender', 'location', 'curfew',
            'accompanyingDetails', 'budget', 'phone', 'leaveByTime', 'transitMins', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));

        allow delete: if isSignedIn() &&
          isValidId(lobbyCode) &&
          isValidId(memberId) &&
          existing().userId == request.auth.uid;
      }

      match /polls/{pollId} {
        allow get: if isSignedIn() && isValidId(lobbyCode) && isValidId(pollId) &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));
        allow list: if isSignedIn() && existing().lobbyCode == lobbyCode;

        allow create: if isSignedIn() &&
          isValidId(lobbyCode) &&
          isValidId(pollId) &&
          isValidPollOption(incoming()) &&
          incoming().lobbyCode == lobbyCode &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));

        allow update: if isSignedIn() &&
          isValidId(lobbyCode) &&
          isValidId(pollId) &&
          isValidPollOption(incoming()) &&
          incoming().lobbyCode == existing().lobbyCode &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'updatedAt']) &&
          exists(/databases/$(database)/documents/lobbies/$(lobbyCode));
      }
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId);
      allow list: if isSignedIn() && existing().safetyRating >= 1;

      allow create: if isSignedIn() &&
        isValidId(reviewId) &&
        isValidAreaReview(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow delete: if isSignedIn() &&
        isValidId(reviewId) &&
        existing().userId == request.auth.uid;
    }
  }
}
