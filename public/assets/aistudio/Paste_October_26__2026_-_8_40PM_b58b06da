<script>
  // Simple interactive toggle feedback for filter pills
  (function initSafetyFilters() {
    const pills = document.querySelectorAll('.filter-pill');
    const dimLitZone = document.getElementById('dimlit-stretches');
    const dimBadge = document.getElementById('badge-dimlit');
    const liquorHazard = document.getElementById('hazard-zone-outer');
    const liquorBadge = document.getElementById('badge-liquor');

    pills.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDim = btn.id === 'toggle-dimlit';
        const isLiquor = btn.id === 'toggle-liquor';

        if (btn.classList.contains('bg-surface-container-high')) {
          // Turn active
          btn.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
          btn.classList.add('bg-primary-container', 'text-on-primary-container');
          if (isDim && dimLitZone) {
            dimLitZone.style.opacity = '1';
            dimBadge.style.display = 'flex';
          }
          if (isLiquor && liquorHazard) {
            liquorHazard.style.opacity = '1';
            liquorBadge.style.display = 'flex';
          }
        } else {
          // Turn inactive
          btn.classList.remove('bg-primary-container', 'text-on-primary-container');
          btn.classList.add('bg-surface-container-high', 'text-on-surface-variant');
          if (isDim && dimLitZone) {
            dimLitZone.style.opacity = '0.2';
            dimBadge.style.display = 'none';
          }
          if (isLiquor && liquorHazard) {
            liquorHazard.style.opacity = '0.1';
            liquorBadge.style.display = 'none';
          }
        }
      });
    });
  })();
